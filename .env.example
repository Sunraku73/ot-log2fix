# Provider: ollama (locale) | openrouter (cloud)
OTLF_PROVIDER=ollama
OTLF_BASE_URL=http://localhost:11434/v1
OTLF_MODEL=qwen3:8b
# Per openrouter: chiave sk-or-... (https://openrouter.ai/keys)
# Modelli ":free" = costo zero; "openrouter/free" = router automatico verso modelli free
OTLF_API_KEY=
OTLF_MAX_CHUNK_CHARS=12000
OTLF_REDACT=true
# Timeout in secondi; su CPU alza a 600 o più se necessario.
OTLF_TIMEOUT=300
# Per log Windows in CP1252 usa cp1252; nessun rilevamento automatico.
OTLF_ENCODING=utf-8
